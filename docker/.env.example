# Local development only.
#
# Copy this file to docker/.env and adjust as needed, then run `docker-compose up`
# from the docker/ directory. Docker Compose loads .env automatically.
#
# In CI/CD, docker/docker-compose.yml is deployed with a generated .env file
# populated from AWS Secrets Manager (see .github/scripts/generate-env-file.sh).
# The values below are LOCAL-ONLY convenience defaults — never reuse them for
# staging or production secrets.

DB_PASSWORD=123
ADMIN_PASSWORD=admin
DEVELOPER_MODE=1
SITE_NAME=hrms.localhost

# Two-factor authentication is enforced by default (docker/configure_2fa.py). Enrolment emails a
# QR code, and a local stack usually has no mail server, so it is off for local development.
FRAPPE_2FA_ENABLED=0
